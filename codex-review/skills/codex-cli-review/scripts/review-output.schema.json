{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "title": {"type": "string"},
          "body": {"type": "string"},
          "file": {"type": "string"},
          "line": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "rule": {
            "type": ["string", "null"]
          },
          "remediation": {"type": "string"}
        },
        "required": [
          "priority",
          "title",
          "body",
          "file",
          "line",
          "rule",
          "remediation"
        ],
        "additionalProperties": false
      }
    },
    "summary": {"type": "string"},
    "residual_risks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "tests_not_run": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "required": ["findings", "summary", "residual_risks", "tests_not_run"],
  "additionalProperties": false
}
